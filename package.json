{
  "name": "poupeazy_mobile",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@expo/ui": "~57.0.18",
    "@expo/vector-icons": "^15.0.2",
    "@hookform/resolvers": "^5.9.1",
    "@react-native-community/netinfo": "12.0.1",
    "@tanstack/react-query": "^5.102.5",
    "expo": "~57.0.22",
    "expo-constants": "~57.0.14",
    "expo-device": "~57.0.2",
    "expo-font": "~57.0.1",
    "expo-glass-effect": "~57.0.3",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-linking": "~57.0.10",
    "expo-router": "~57.0.21",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.86.0",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-pluggy-connect": "^1.6.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@react-native/jest-preset": "0.86.3",
    "@testing-library/react-native": "13.3.3",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "patch-package": "^8.0.1",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "js-yaml": "^4.3.2",
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "^3.15.2"
    }
  },
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "postinstall": "patch-package",
    "test": "jest --runInBand",
    "test:auth": "jest --runInBand --runTestsByPath __tests__/auth-context.test.tsx",
    "test:e2e": "maestro test --test-output-dir .tmp/maestro e2e/",
    "test:e2e:auth": "maestro test --test-output-dir .tmp/maestro e2e/auth.yaml",
    "test:e2e:transacoes": "maestro test --test-output-dir .tmp/maestro e2e/transacoes.yaml",
    "test:e2e:orcamentos": "maestro test --test-output-dir .tmp/maestro e2e/orcamentos-categorias.yaml",
    "test:e2e:metas": "maestro test --test-output-dir .tmp/maestro e2e/metas-open-finance.yaml",
    "test:coverage": "jest --runInBand --coverage",
    "test:watch": "jest --watch"
  },
  "jest": {
    "preset": "jest-expo",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/src/app/"
    ]
  },
  "private": true
}
